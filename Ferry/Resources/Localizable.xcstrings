    "Every window, one Tab away.": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Her pencere bir Tab uzağında."
          }
        }
      }
    },
    "Every window, one Tab away. Ferry needs one permission to work, and one more to show window pictures.": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Her pencere bir Tab uzağında. Ferry'nin çalışmak için bir, pencere görüntülerini göstermek için bir izne daha ihtiyacı var."
          }
        }
      }
    },
    "Excluded Apps": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Hariç Tutulanlar"
          }
        }

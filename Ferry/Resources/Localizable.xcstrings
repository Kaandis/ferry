    "Show windows when hovering a Dock icon": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dock simgesinin üzerine gelince pencereleri göster"
          }
        }
      }
    },
    "Shows a picture of each window. Without it you see app icons. Pictures stay in memory and are never saved or sent.": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Her pencerenin görüntüsünü gösterir. İzin vermezsen uygulama simgeleri görünür. Görüntüler yalnızca bellekte durur; asla kaydedilmez ya da gönderilmez."
          }
        }
      }
    },

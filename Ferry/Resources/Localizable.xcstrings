    "Ferry": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ferry"
          }
        }
      }
    },
    "Ferry listens to the Dock itself, not to mouse movement.": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ferry fare hareketini değil, Dock'un kendisini dinler."
          }
        }
      }
    },
    "Ferry replaces the system’s ⌘Tab while it runs, and hands it back when you quit.": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ferry çalışırken sistemin ⌘Tab'ının yerini alır, çıkınca geri verir."
          }
        }
      }
    },
